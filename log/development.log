1:    <p style="color: green"><%= notice %></p>
2:    
3:    <h1>Owners</h1>
4:    
5:    
6:    <table class="table table-striped table-bordered table-hover">
7:      <thead class="table-dark">
8:        <tr>
9:          <th scope="col">Name</th>
10:          <th scope="col">Email</th>
11:          <th scope="col">Phone</th>
12:          <th scope="col">Address 1</th>
13:          <th scope="col">Address 2</th>
14:          <th scope="col">City</th>
15:          <th scope="col">State</th>
16:          <th scope="col">Zip</th>
17:          <th scope="col">Owner Type</th>
18:          <th scope="col">Actions</th>
19:        </tr>
20:      </thead>
21:    
22:      <tbody>
23:      <% @owners.each do |owner| %>
24:        <tr>
25:              <td><%= owner.first_name + ' ' + owner.last_name %></td>  
26:              <td><%= owner.email %></td>
27:              <td><%= owner.phone %></td>
28:              <td><%= owner.address1 %></td>
29:              <td><%= owner.address2 %></td>
30:              <td><%= owner.city %></td>
31:              <td><%= owner.state %></td>
32:              <td><%= owner.zip %></td>
33:              <td><%= owner.ownertype %></td>
34:              <td class="d-flex justify-content-around">
35:      			<%= link_to owner, style: "text-decoration:none" do %>
36:      			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16" >
37:      			<path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z"/>
38:      			<path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/>
39:    			</svg>
40:      			<% end %>
41:             	
42:             	<%= link_to edit_owner_path(owner), style: "text-decoration:none" do %> 
43:      			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
44:      			<path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 
45:      			0 0 0 0-.708l-3-3zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 
46:      			0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207l6.5-6.5zm-7.468 
47:      			7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 
48:      			0 0 1-.5-.5V10h-.5a.499.499 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 
49:      			0 .65.65l5-2a.5.5 0 0 0 .168-.11l.178-.178z"/>
50:    			</svg>
51:      			<% end %> 
52:      			
53:      			<%= link_to owner_path(owner), data: {turbo_method: :delete, }, style: "text-decoration:none" do %>
54:      			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
55:      			<path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1H2.5zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5zM8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5zm3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0z"/>
56:    			</svg>
57:      			<% end %>
58:      			</td>
59:      			
60:      			
61:      			<td>
62:      			<%= link_to "#" { data: { toggle: "modal", target: "#deleteModal" }, style: "text-decoration:none" } do %>
63:      			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
64:      			<path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1H2.5zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5zM8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5zm3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0z"/>
65:    			</svg>
66:        		<% end %>
67:        		
68:        		<div class="modal fade" id="deleteModal" role="dialog">
69:         		 <div class="modal-dialog">
70:         		  <div class="modal-content">
71:    				<div class="modal-header">
72:    					<button type="button" class="close" data-dismiss="modal">Confirmation Box</button>
73:             		</div>
74:              		<div class="modal-body">
75:                		<p>Are you sure you want to delete this owner?</p>
76:              		</div>
77:              		<div class="modal-footer">
78:                		<div class="modal-footer">
79:     					<%= link_to 'Destroy', owner_path(owner), data: {turbo_method: :delete}, :class=>'btn btn-danger'%>
80:    						<a href="#" data-dismiss="modal" class="btn btn-warning">Cancel</a>
81:                		</div>
82:              		</div>
83:            	</div>
84:    			</div>
85:    			</div>
86:      		</td>
87:            </tr>
88:        
89:      <% end %>
90:    
91:     </tbody>
92:    </table>
93:    
94:    <br>
95:    <%= link_to "New owner", new_owner_path, class: "btn btn-primary" %>
  
