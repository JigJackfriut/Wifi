<%= form_with(model: wlan) do |form| %>
  <% if wlan.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(wlan.errors.count, "error") %> prohibited this WLAN from being saved:</h2>

      <ul>
        <% wlan.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  
<% if wlan.manager == current_manager%>
  
   <div class="form-group mb-3">
	<label>Name</label>
    <%= form.text_field :name, class: "form-control" %>
   </div>

  <div class="form-group mb-3">
	<label>Description</label>
    <%= form.text_field :description, class: "form-control" %>
  </div>
 
 
  <% if wlan.mode == "A" and form.object.a %> 
		<div class="form-group mb-3">
		<label>Selected A</label> <br>
			<%= form.select(:selected_a, options=parseChannels(form.object.a), html_options = {:include_hidden => false, :include_blank => false, class: "dropdown"}, { :multiple => true} )%>  <br/>
				<em>(Hold down the Ctrl (PC) or Command (Mac) key for multiple selections.)</em> 

	   <br>
			<em> <%= form.label :a, "Available A Channels: #{parseArray(form.object.a)}", style: "display: block" %> </em>
		</div>
		<br>
  <% elsif wlan.mode =="A" and !form.object.a %>
		<p style="color: red"> No A channels. Please switch modes. </p>
  <% elsif wlan.mode == "G" %>
  
		<div class="form-group mb-3">
			<label>Selected G</label> <br>
			<%= form.select(:selected_g, options=parseChannels(form.object.g), html_options = {:include_hidden => false, :include_blank => false, class: "dropdown"}, {:multiple => true} ) %>  <br/>
				<em>(Hold down the Ctrl (PC) or Command (Mac) key for multiple selections.)</em> 

	   <br> 
		<div>
			<em> <%= form.label :g, "Available G Channels: #{parseArray(form.object.g)}", style: "display: block" %> </em>
		</div>
		<br>
  <% end %>
  
  <div class="form-group mb-3">
	<label>Zone</label><br>
  <%= form.collection_select(:zone, Zone.where(manager_id: current_manager.id), :id, :name, options = {include_hidden: false, include_blank: "no zone" }, html_options = {class: "dropdown"}) %>  <br/>
<br/>
  <div>
  
  <div class="form-group mb-3">
    <%= form.number_field :client_id, id: :wificlient_wlan_id, type: :hidden %>
  </div>

   <div class="form-group mb-3">
    <%= form.submit "Update WLAN", class: "btn btn-primary" %>
  </div>
 <%else%>
	<h2> "You are not allowed to access this page." </h2>
 <% end %>
<% end %>

