<%= form_with(model: wlan) do |form| %>
  <% if wlan.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(wlan.errors.count, "error") %> prohibited this WLAN from being saved:</h2>

      <ul>
        <% wlan.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.text_field :description %>
  </div>
  <br>
  
   <div>
    <%= form.label :selected_a, 'Selected A Channels', style: "display: block" %>
    <%= form.text_field :selected_a  %>
  </div>
   <div>
    <em> <%= form.label :a, "Available A Channels: #{parseArray(form.object.a)}", style: "display: block" %> </em>
  </div>
  <br>
  
 
  
  <div>
    <%= form.label :selected_g, 'Selected G Channels', style: "display: block" %>
    <%= form.text_field :selected_g  %>
  </div>
   <div>
   <em> <%= form.label :g, "Available G Channels: #{parseArray(form.object.g)}", style: "display: block" %> </em>
  </div>
  <br>
  
  <div class="field">
  <%= form.label :zone, style: "display: block" %>
  <%= form.collection_select(:zone, Zone.all, :name, :name, options = {include_hidden: false, include_blank: "no zone" }, html_options = {class: "dropdown"}) %>  <br/>
<br/>
  <div>
  
  <div class="form-group mb-3">
    <%= form.number_field :client_id, id: :wificlient_wlan_id, type: :hidden %>
  </div>

   <div class="form-group mb-3">
    <%= form.submit "Update WLAN", class: "btn btn-primary" %>
  </div>
  
<% end %>

