<%= form_with(model: wificlient) do |form| %>
  <% if wificlient.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(wificlient.errors.count, "error") %> prohibited this wificlient from being saved:</h2>

      <ul>
        <% wificlient.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <br>

  <div class="form-group mb-3">
	<label>Location</label>
    <%= form.text_field :location, class: "form-control" %>
   </div>

  <div class="form-group mb-3">
	<label>IP Address</label>
    <%= form.text_field :ipaddress, class: "form-control" %>
   </div>

  <div class="form-group mb-3">
	<label>Client Version</label>
    <%= form.text_field :clientversion, class: "form-control" %>
  </div>

  <div class="form-group mb-3">
	<label>OS Version</label>
    <%= form.text_field :osversion, class: "form-control" %>
  </div>

  <div class="form-group mb-3">
	<label>HW Model</label>
    <%= form.text_field :hwmodel, class: "form-control" %>
  </div>
	
  <div class="form-group mb-3">
  	<label>Status</label>
    <%= form.text_field :status, class: "form-control" %>
  </div>
    
  <div class="form-group mb-3">
  	<label>Poll Rate</label>
    <%= form.text_field :pollrate, class: "form-control" %>
  </div>
    
  <div class="form-group mb-3">
  	<label>Last Seen</label>
   <!-- <%= form.text_field :lastseen, class: "form-control" %>-->
	<%= form.datetime_field :lastseen, style: "display: block" %>
   </div>
    
  <!--<div>
    <%= form.label :lastseen, style: "display: block" %>
    <%= form.datetime_field :lastseen %>
  </div>-->
  
  <div class="form-group mb-3">
  	<label>Note</label>
    <%= form.text_field :note, class: "form-control" %>
  </div>
  
  <div class="form-group mb-3">
  	<label>Name</label>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <!--<div>
    <%= form.label :dateadded, style: "display: block" %>
    <%= form.datetime_field :dateadded %>
  </div>-->
  
  <div class="form-group mb-3">
  	<label>Date Added</label>
	<%= form.datetime_field :dateadded, style: "display: block" %>
  </div>
  
   <div class="form-group mb-3">
  	<label>Config Hash</label>
    <%= form.text_field :confighash, class: "form-control" %>
  </div>
  
   <div class="form-group mb-3">
  	<label>Account ID</label>
    <%= form.number_field :account_id,id: :wificlient_account_id, class: "form-control", value: current_manager.id %>
  </div>

  <div class="form-group mb-3">
    <%= form.submit "Create WLAN Client", class: "btn btn-primary" %>
  </div>
<% end %>


