<%= form_with(model: wificlient) do |form| %>
  <% if wificlient.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(wificlient.errors.count, "error") %> prohibited this wificlient from being saved:</h2>

      <ul>
        <% wificlient.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <br>
<% if wificlient.manager == current_manager%>

<% if current_page?(controller:'wificlients', action: 'new') %> 

   <div class="form-group mb-3">
	<label>Mac</label>
    <%= form.text_field :mac, class: "form-control" %>
   </div>
   
   <div class="form-group mb-3">
    <%= form.submit "Create Wi-Fi Client", class: "btn btn-primary" %>
  </div>

<% else %>

  <div class="form-group mb-3">
	<label>Location</label>
    <%= form.text_field :location, class: "form-control" %>
   </div>
	
 
  <div class="form-group mb-3">
  	<label>Note</label>
    <%= form.text_field :note, class: "form-control" %>
  </div>
  
  <div class="form-group mb-3">
  	<label>Name</label>
    <%= form.text_field :name, class: "form-control" %>
  </div>

   <div class="form-group mb-3">
    <%= form.number_field :manager_id, id: :wificlient_manager_id, class: "form-control", value: current_manager.id, type: :hidden %>
  </div>

  <div class="form-group mb-3">
    <%= form.submit "Update Wi-Fi Client", class: "btn btn-primary" %>
  </div>
  <% end%>
  <%else%> 

	<h2> "You are not allowed to on this page have access to this page" </h2>

<% end%>

<% end %>

