<%= form_with(model: account) do |form| %>
  <% if account.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(account.errors.count, "error") %> prohibited this account from being saved:</h2>

      <ul>
        <% account.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <br> 

  <div class="form-group mb-3">
    <label>First Name</label>
    <%= form.text_field :first_name, class: "form-control" %>
  </div>
    
  <div class="form-group mb-3">
    <label>Last Name</label>
    <%= form.text_field :last_name, class: "form-control" %>
  </div>
 
  <div class="form-group mb-3">
    <label>Email</label>
    <%= form.email_field :email, class: "form-control" %>
  </div>
  
  <div class="form-group mb-3">
    <label>Phone</label>
    <%= form.text_field :phone, class: "form-control" %>
  </div>
 
  <div class="form-group mb-3">
    <label>Address 1</label>
    <%= form.text_field :address1, class: "form-control" %>
  </div>
 
  <div class="form-group mb-3">
    <label>Address 2</label>
    <%= form.text_field :address2, class: "form-control" %>
  </div>
 
  <div class="form-group mb-3">
    <label>City</label>
    <%= form.text_field :city, class: "form-control" %>
  </div>
 
  <div class="form-group mb-3">
    <label>State</label>
    <%= form.text_field :state, class: "form-control" %>
  </div>

  <div class="form-group mb-3">
    <label>Zip</label>
    <%= form.text_field :zip, class: "form-control" %>
  </div>

  <div class="form-group mb-3">
    <label>Account Type</label>
    <%= form.text_field :accounttype, class: "form-control" %>
  </div>
  
  <div class="form-group mb-3">
    <label>Password</label>
    <%= form.password_field :password, class: "form-control" %>
  </div>

  <div class="form-group mb-3">
    <%= form.label :admin %>
    <%= form.check_box :admin %>
  </div>

  <div class="form-group mb-3">
    <%= form.submit(class: "btn btn-primary") %>
  </div>
<% end %>

