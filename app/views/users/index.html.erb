<h1>Users</h1>

<table class="table table-striped table-bordered table-hover">
  <thead class="table-dark">
    <tr>
      <th scope="col">Name</th>
      <th scope="col">User Type</th>
      <th scope="col">Passphrase</th>
       <th scope="col">Zones</th>
       <th scope="col">Maximum<br/>Devices</th>
       <th scope="col">Max Up</th>
       <th scope="col">Max Down</th>
	   <th scope="col">VLAN ID</th>
	    <th scope="col">Enabled</th>
	  <th scope="col">Actions</th>
    </tr>
  </thead>

  <tbody id="users_table">
  <% @users.each do |user| %>
	<% if user.manager_id == current_manager.id%>
   <tr>
          <td><a class="btn btn-link" role = "button" data-bs-toggle="collapse" href="#collapse<%= user.id %>" aria-expanded="false" aria-controls="collapse<%= user.id %>">
              <%= user.name %>
            </a></td>  
          <td><%= user.user_type %></td>
          <td><%= user.passphrase %></td>
          <td><%= parseZones(user) %> </td>
          <td><%= eval_parameter_nums(user.maxdev) %> </td>
          <td><%= eval_parameter_nums(user.upmax) %> </td>
          <td><%= eval_parameter_nums(user.downmax) %> </td>
		  <td><%= user.vlan_id %></td>
		    <td><%= form_with(model: user) do |form| %>
				<%= form.check_box :enabled, checked: user.enabled, onchange: "this.form.requestSubmit();" %>
				<%end%>
		  </td>
      <td class="center">
        <div class="d-flex justify-content-center">
        <%= user_action_links(user) %>
        </div>
    </td>
  	</tr>
    <tr>
          <td colspan="14">
            <div class="collapse" id="collapse<%= user.id %>">
              <div class="card card-body">
                <strong>Active Users</strong>
                <div>
                  <table class="table table-striped table-bordered table-hover">
                    <thead class="table-dark">
                      <tr>
                        <th scope="col">SSID</th>
                        <th scope="col">Station Mac</th>
                        <th scope="col">AP</th>
                        <th scope="col">WLAN</th>
                        <th scope="col">Channel</th>
                        <th scope="col">VLAN</th>
                        <th scope="col">Rx Bytes</th>
                        <th scope="col">Tx Bytes</th>
                        <th scope="col">Signal</th>
                        <th scope="col">Tx Fail</th>
                        <th scope="col">Time Connected</th>
                        <th scope="col">Connected At</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% @active_users.each do |station_log| %>
                        <% if station_log.user_id == user.id %>
                          <tr>          
                      <td><%= station_log.ssid %></td>
                      <td><%= station_log.mac %></td>
                      <td><%= link_to Wificlient.find_by(mac: station_log.ap_mac).name, wificlient_path(Wificlient.find_by(mac: station_log.ap_mac)), style: "text-decoration:none" %></td>
                      <td><%= station_log.interface %></td>
                      <td><%= station_log.channel %></td>
                      <td><%= station_log.vid %></td>
                      <td><%= bytes_conversion(station_log.rx_bytes) %></td>
                      <td><%= bytes_conversion(station_log.tx_bytes) %></td>
                      <td><%= station_log.signal %></td>
                      <td><%= station_log.tx_failed %></td>
                      <td><%= secondsToTime(station_log.connected_time) %></td>
                      <td><%= station_log.created_at %></td>
                          </tr>
                        <% end %>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </td>
        </tr>
  	<% end %>
  	 <% end %>
   </tbody>
</table>

<%= link_to "New user", new_user_path %>


<style>
.center {
    vertical-align: middle;
    justify-content: center;
}
</style>
