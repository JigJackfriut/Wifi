<div id="<%= dom_id user %>">
  <p>
    <strong>Name:</strong>
    <%= user.name %>
  </p>

  <p>
    <strong>Type:</strong>
    <%= user.user_type %>
  </p>

  <p>
    <strong>Passphrase:</strong>
    <%= user.passphrase %>
  </p>

  <p>
    <strong>Manager:</strong>
    <%= user.manager_id %>
  </p>

  <p>
    <strong>Zone:</strong>
    <%= user.zone %>
  </p>

</div>
