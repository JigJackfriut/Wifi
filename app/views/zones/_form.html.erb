<%= form_with(model: zone) do |form| %>
  <% if zone.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(zone.errors.count, "error") %> prohibited this zone from being saved:</h2>

      <ul>
        <% zone.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

<% if zone.manager == current_manager%>

  <div class = "form-group mb-3">
    <label>Name</label>
    <%= form.text_field :name, class:"form-control" %>
  </div>

  <div class = "form-group mb-3">
    <label>Description</label>
    <%= form.text_field :description, class:"form-control" %>
  </div>

  <div class = "form-group mb-3">
	<label>SSID</label>
    <%= form.text_field :ssid, class:"form-control" %>
  </div>

	<div>
    <%= form.number_field :manager_id, id: :zone_manager_id, class: "form-control", value: current_manager.id, type: :hidden %>
  </div>

  <div class ="form-group mb-3">
    <%= form.submit "Update Zone", class:"btn btn-primary" %>
  </div>
 <% else %>
	<h2> "You are not allowed to access this page." </h2>
 <% end %>
<% end %>
