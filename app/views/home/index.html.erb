<body style="background-color: LightSkyBlue">
<center>
<h1 style="font-family: Aqua Grotesque">Welcome to Wifi Control</h1>
</br>
<div class=" actions form-group mb-3">
<% if manager_signed_in?%>
    <%= link_to 'Sign Out', destroy_manager_session_path, data: {turbo_method: :delete }, class:"btn btn-primary"%> 
