<body style="background-color: LightSkyBlue">
<center>
</br>
<div class=" actions form-group mb-3">
<% if manager_signed_in?%>
	<h1>Welcome <%= current_manager.first_name %>!</h1> </br>
 	<h3>Thank you for providing your info! See you at home <%= current_manager.address1%>  <%= current_manager.city%> <%= current_manager.state%> <%= current_manager.zip%></h3></br>
    <%= link_to 'Sign Out', destroy_manager_session_path, data: {turbo_method: :delete }, class:"btn btn-primary"%>   &nbsp;&nbsp;&nbsp;
    <%= link_to 'Edit Profile', edit_manager_registration_path,  class:"btn btn-primary"%> 
<% else %>
	<h1>Welcome!</h1> </br>
 	<h2>Please login or sign up</h2> </br>
	<%= link_to 'Sign Up', new_manager_registration_path, class:"btn btn-primary"%> &nbsp;&nbsp;&nbsp;
    <%= link_to 'Log In', new_manager_session_path, class:"btn btn-primary"%> 
        <% end %>
  </div>
 </center> 
</body>
   