<h1>Log Summary</h1>

<table class="table table-striped table-bordered table-hover">
  <thead class="table-dark">
    <tr>
	  <th><%= link_to "Username", :sort => "Username"%> </th>
      <th scope="col">SSID</th>
	  <th scope="col">Station Mac</th>
	  <th scope="col">AP Mac</th>
      <th scope="col">WLAN</th>
	  <th scope="col">VLAN</th>
      <th><%= link_to "RX Bytes", :sort => "rx_bytes"%> </th>
	  <th scope="col">TX Bytes</th>
	  <th scope="col">Signal</th>
	  <th scope="col">TX Fail </th>
	  <th scope="col">Time Connected </th>
	  <th scope="col">Created At</th>
	  <th scope="col">Actions</th>
    </tr>
  </thead>

  <tbody>
  <% @station_logs.each do |station_log| %>

   <tr>
		  <td><%= User.find_by(id: station_log.user_id).name %> </td>
		  <td><%= station_log.ssid %></td>  
		  <td><%= station_log.mac %></td>
		  <td><%= Wificlient.find_by(mac: station_log.ap_mac).name %></td>
          <td><%= station_log.interface %></td>
		  <td><%= station_log.vid %></td>
          <td><%= station_log.rx_bytes %> </td>
		  <td><%= station_log.tx_bytes %></td>
		  <td><%= station_log.signal %></td>
		  <td><%= station_log.tx_failed %></td>
		  <td><%= station_log.connected_time %></td>
		  <td><%= station_log.created_at %></td>
          <td class="justify-content-around">
  			<%= link_to station_log, style: "text-decoration:none" do %>
  			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16" >
  			<path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z"/>
  			<path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/>
			</svg>
  			<% end %>
  			
         	<%= link_to edit_station_log_path(station_log), style: "text-decoration:none" do %> 
  			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
  			<path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 
  			0 0 0 0-.708l-3-3zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 
  			0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207l6.5-6.5zm-7.468 
  			7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 
  			0 0 1-.5-.5V10h-.5a.499.499 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 
  			0 .65.65l5-2a.5.5 0 0 0 .168-.11l.178-.178z"/>
			</svg>
  			<% end %> 
  			
  			<%= link_to station_log_path(station_log), data: {turbo_method: :delete, }, style: "text-decoration:none" do %>
  			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
  			<path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1H2.5zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5zM8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5zm3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0z"/>
			</svg>
  			<% end %>
    	</td>
  	</tr>
  	<% end %>
  	
   </tbody>
</table>

<%= link_to "New station log", new_station_log_path %>
