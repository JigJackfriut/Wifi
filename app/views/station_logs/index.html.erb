  <tbody>
<% @active_users.each do |user| && @active_users.each where managers= current.managers%>
   
      <tr>
        <td><%= user.ssid %></td>
        <td><%= user.mac %></td>
        <td><%= Wificlient.find_by(mac: user.ap_mac).name %></td>
        <td>
          <%= form_with(model: log, url: update_mac_name_station_log_path(log), local: true, method: :patch) do |form| %>
            <%= form.text_field :mac_name, value: log.mac_name, placeholder: "Enter name" %>
            <%= form.submit "Save" %>
          <% end %>
        </td>
        <td><%= user.interface %></td>
        <td><%= user.channel %></td>
        <td><%= user.vid %></td>
        <td><%= bytes_conversion(user.rx_bytes) %></td>
        <td><%= bytes_conversion(user.tx_bytes) %></td>
        <td><%= user.signal %></td>
        <td><%= user.tx_failed %></td>
        <td><%= secondsToTime(user.connected_time) %></td>
        <td><%= user.created_at %></td>
      </tr>
    
  <% end %>
</tbody>

