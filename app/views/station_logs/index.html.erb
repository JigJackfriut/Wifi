<ul class=”pagination”>

<li class=”disabled”> <%= will_paginate(@station_logs,:previous_label => "&laquo;", :next_label => "&raquo;",:class=>"small-font",:outer_window => 1,:inner_window => 0) %></li>

</ul>
<%= page_entries_info @station_logs%>
