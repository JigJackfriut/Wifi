<div id="<%= dom_id station_log %>">
  <p>
    <strong>Ap:</strong>
    <%= station_log.AP %>
  </p>

  <p>
    <strong>Station:</strong>
    <%= station_log.station %>
  </p>

  <p>
    <strong>Interface:</strong>
    <%= station_log.interface %>
  </p>

  <p>
    <strong>Channel:</strong>
    <%= station_log.channel %>
  </p>

  <p>
    <strong>Rx bytes:</strong>
    <%= station_log.rx_bytes %>
  </p>

  <p>
    <strong>Tx bytes:</strong>
    <%= station_log.tx_bytes %>
  </p>

  <p>
    <strong>Tx retries:</strong>
    <%= station_log.tx_retries %>
  </p>

  <p>
    <strong>Tx failed:</strong>
    <%= station_log.tx_failed %>
  </p>

  <p>
    <strong>Signal:</strong>
    <%= station_log.signal %>
  </p>

  <p>
    <strong>Signal avg:</strong>
    <%= station_log.signal_avg %>
  </p>

  <p>
    <strong>Tx bitrate:</strong>
    <%= station_log.tx_bitrate %>
