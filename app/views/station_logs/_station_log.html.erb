  <p>
    <strong>Expected throughput:</strong>
    <%= station_log.expected_throughput %>
  </p>

  <p>
    <strong>Associated:</strong>
    <%= station_log.associated %>
  </p>

  <p>
    <strong>Vid:</strong>
    <%= station_log.vid %>
  </p>

  <p>
    <strong>Ssid:</strong>
    <%= station_log.ssid %>
  </p>

  <p>
    <strong>User:</strong>
    <%= station_log.user_id %>
  </p>

  <p>
    <strong>Event:</strong>
    <%= station_log.event %>
  </p>

  <p>
    <strong>Mac:</strong>
    <%= station_log.mac %>
  </p>

</div>
