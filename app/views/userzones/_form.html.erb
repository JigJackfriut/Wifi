<%= form_with(model: userzone) do |form| %>
  <% if userzone.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(userzone.errors.count, "error") %> prohibited this userzone from being saved:</h2>

      <ul>
        <% userzone.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :zone_id, style: "display: block" %>
    <%= form.number_field :zone_id %>
  </div>
  
  <div>
    <%= form.number_field :manager_id, id: :userzone_manager_id, class: "form-control", value: current_manager.id, type: :hidden %>
  </div>


  <div>
    <%= form.label :pmk, style: "display: block" %>
    <%= form.text_field :pmk %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
