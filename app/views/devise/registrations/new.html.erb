<h2>Sign up</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  
  <div class="field form-group mb-3">
    <%= f.label :first_name %><br />
    <%= f.text_field :first_name , autofocus: true, autocomplete: "first_name", class: "form-control" %>
  </div>
  
  <div class="field form-group mb-3">
    <%= f.label :last_name %><br />
    <%= f.text_field :last_name, autofocus: true, autocomplete: "last_name", class: "form-control" %>
  </div>

  <div class="field form-group mb-3">
    <%= f.label :email %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
  </div>

  <div class="field form-group mb-3">
    <%= f.label :password %>
    <% if @minimum_password_length %>
    <em>(<%= @minimum_password_length %> characters minimum)</em>
    <% end %><br />
    <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
  </div>

  <div class="field form-group mb-3">
    <%= f.label :password_confirmation %><br />
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
  </div>
  
  <div class="field form-group mb-3">
    <%= f.label :phone %><br />
    <%= f.text_field :phone , autofocus: true, autocomplete: "phone", class: "form-control" %>
  </div>
  
  <div class="field form-group mb-3">
    <%= f.label :address1 %><br />
    <%= f.text_field :address1, autofocus: true, autocomplete: "address1", class: "form-control" %>
  </div>
  
  <div class="field form-group mb-3">
    <%= f.label :address2 %><br />
    <%= f.text_field :address2 , autofocus: true, autocomplete: "address2", class: "form-control" %>
  </div>
  
  <div class="field form-group mb-3">
    <%= f.label :city %><br />
    <%= f.text_field :city, autofocus: true, autocomplete: "city", class: "form-control" %>
  </div>
  
  <div class="field form-group mb-3">
    <%= f.label :state %><br />
    <%= f.text_field :state , autofocus: true, autocomplete: "state", class: "form-control" %>
  </div>
  
  <div class="field form-group mb-3">
    <%= f.label :zip %><br />
    <%= f.text_field :zip, autofocus: true, autocomplete: "zip", class: "form-control" %>
  </div>
  
  <div class="field form-group mb-3">
    <%= f.label :account_type %><br />
    <%= f.text_field :account_type , autofocus: true, autocomplete: "account_type", class: "form-control" %>
  </div>
  

  <div class="actions form-group mb-3">
    <%= f.submit "Sign up", class:"btn btn-primary" %>
    <%= render "devise/shared/links" %>
  </div>
<% end %>

